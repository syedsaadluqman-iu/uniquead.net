<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_advertising" model="ir.module.category">
        <field name="name">Advertising</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_advertising_sales" model="res.groups">
        <field name="name">Sales / Booking Staff</field>
        <field name="category_id" ref="module_category_advertising"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_advertising_operations" model="res.groups">
        <field name="name">Operations Staff</field>
        <field name="category_id" ref="module_category_advertising"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_advertising_accounting" model="res.groups">
        <field name="name">Accounting Staff</field>
        <field name="category_id" ref="module_category_advertising"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_advertising_manager" model="res.groups">
        <field name="name">Manager / Administrator</field>
        <field name="category_id" ref="module_category_advertising"/>
        <field name="implied_ids" eval="[(4, ref('group_advertising_sales')), (4, ref('group_advertising_operations')), (4, ref('group_advertising_accounting'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="advertising_site_comp_rule" model="ir.rule">
            <field name="name">Advertising site multi-company</field>
            <field name="model_id" ref="model_advertising_site"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="advertising_booking_comp_rule" model="ir.rule">
            <field name="name">Advertising booking multi-company</field>
            <field name="model_id" ref="model_advertising_booking"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="advertising_booking_line_comp_rule" model="ir.rule">
            <field name="name">Advertising booking line multi-company</field>
            <field name="model_id" ref="model_advertising_booking_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="advertising_booking_charge_comp_rule" model="ir.rule">
            <field name="name">Advertising booking charge multi-company</field>
            <field name="model_id" ref="model_advertising_booking_charge"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
