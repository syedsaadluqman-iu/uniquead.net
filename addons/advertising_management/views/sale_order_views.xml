<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_advertising" model="ir.ui.view">
        <field name="name">sale.order.form.advertising</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_convert_to_booking" string="Convert to Booking" type="object"
                        class="oe_highlight" groups="advertising_management.group_advertising_sales"
                        invisible="not is_advertising or advertising_booking_id or state == 'cancel'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_advertising_booking" type="object" class="oe_stat_button"
                        icon="fa-calendar-check-o" string="Booking" invisible="not advertising_booking_id"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not advertising_conflict_message">
                    <field name="advertising_conflict_message" class="mb-0"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_advertising" groups="advertising_management.group_advertising_sales"/>
                <field name="advertising_request" invisible="not is_advertising" readonly="1"/>
                <field name="advertising_booking_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='sequence']" position="after">
                <field name="advertising_site_id" optional="show"/>
                <field name="advertising_date_start" optional="show" required="advertising_site_id"
                       column_invisible="not parent.is_advertising"/>
                <field name="advertising_date_end" optional="show" required="advertising_site_id"
                       column_invisible="not parent.is_advertising"/>
                <field name="advertising_billing_frequency" optional="show"
                       column_invisible="not parent.is_advertising"/>
            </xpath>
        </field>
    </record>

    <record id="advertising_request_action" model="ir.actions.act_window">
        <field name="name">Booking Requests</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_advertising', '=', True), ('advertising_request', '=', True), ('state', 'in', ('draft', 'sent'))]</field>
        <field name="context">{'default_is_advertising': True, 'default_advertising_request': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No booking request yet</p>
            <p>Requests submitted by customers appear here, ready to be turned into quotations.</p>
        </field>
    </record>

    <record id="advertising_quotation_action" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_advertising', '=', True)]</field>
        <field name="context">{'default_is_advertising': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an advertising quotation</p>
            <p>Add sites with their rental periods, then send the quotation to your customer.</p>
        </field>
    </record>
</odoo>
