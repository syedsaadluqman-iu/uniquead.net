<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standard invoice / bill form: link to the booking, lease and sites -->
    <record id="advertising_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form.advertising</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="advertising_booking_id" string="Advertising Booking"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       groups="account.group_account_readonly"/>
                <field name="advertising_lease_id" string="Landlord Lease"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       groups="account.group_account_readonly"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="advertising_site_id" optional="show" groups="account.group_account_readonly"/>
            </xpath>
        </field>
    </record>

    <!-- Customer invoices of bookings -->
    <record id="advertising_invoice_view_list" model="ir.ui.view">
        <field name="name">advertising.invoice.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Invoices" decoration-danger="advertising_overdue" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id" string="Customer"/>
                <field name="advertising_booking_id"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="amount_total" sum="Total"/>
                <field name="advertising_amount_paid" sum="Paid"/>
                <field name="amount_residual" sum="Outstanding"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state in ('paid', 'in_payment')"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"/>
                <field name="advertising_overdue" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"
                       decoration-muted="state in ('draft', 'cancel')"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="move_type" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advertising_bill_view_list" model="ir.ui.view">
        <field name="name">advertising.bill.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Vendor Bills" decoration-danger="advertising_overdue" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id" string="Landlord"/>
                <field name="advertising_lease_id"/>
                <field name="invoice_date" string="Bill Date"/>
                <field name="invoice_date_due"/>
                <field name="amount_total" sum="Total"/>
                <field name="advertising_amount_paid" sum="Paid"/>
                <field name="amount_residual" sum="Outstanding"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state in ('paid', 'in_payment')"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"/>
                <field name="advertising_overdue" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"
                       decoration-muted="state in ('draft', 'cancel')"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="move_type" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advertising_move_view_search" model="ir.ui.view">
        <field name="name">advertising.move.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Number"/>
                <field name="partner_id"/>
                <field name="advertising_booking_id"/>
                <field name="advertising_lease_id"/>
                <field name="invoice_line_ids" string="Site"
                       filter_domain="[('invoice_line_ids.advertising_site_id', 'ilike', self)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="unpaid" string="Unpaid"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="overdue" string="Overdue" domain="[('advertising_overdue', '=', True)]"/>
                <filter name="paid" string="Paid"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('paid', 'in_payment'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_booking" string="Booking" context="{'group_by': 'advertising_booking_id'}"/>
                    <filter name="group_lease" string="Lease" context="{'group_by': 'advertising_lease_id'}"/>
                    <filter name="group_month" string="Invoice Month" context="{'group_by': 'invoice_date:month'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advertising_invoice_action" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('advertising_booking_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="search_view_id" ref="advertising_move_view_search"/>
    </record>
    <record id="advertising_invoice_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="advertising_invoice_view_list"/>
        <field name="act_window_id" ref="advertising_invoice_action"/>
    </record>
    <record id="advertising_invoice_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account.view_move_form"/>
        <field name="act_window_id" ref="advertising_invoice_action"/>
    </record>

    <record id="advertising_bill_action" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('advertising_lease_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="search_view_id" ref="advertising_move_view_search"/>
    </record>
    <record id="advertising_bill_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="advertising_bill_view_list"/>
        <field name="act_window_id" ref="advertising_bill_action"/>
    </record>
    <record id="advertising_bill_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account.view_move_form"/>
        <field name="act_window_id" ref="advertising_bill_action"/>
    </record>

    <!-- Site profitability -->
    <record id="advertising_profitability_view_pivot" model="ir.ui.view">
        <field name="name">advertising.profitability.pivot</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Site Profitability" sample="1">
                <field name="advertising_site_id" type="row"/>
                <field name="move_type" type="col"/>
                <field name="advertising_result" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="advertising_profitability_view_list" model="ir.ui.view">
        <field name="name">advertising.profitability.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Site Journal Items" create="0" edit="0">
                <field name="date"/>
                <field name="move_id"/>
                <field name="advertising_site_id"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="advertising_period_start" optional="hide"/>
                <field name="advertising_period_end" optional="hide"/>
                <field name="advertising_result" sum="Result"/>
                <field name="company_currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advertising_profitability_view_search" model="ir.ui.view">
        <field name="name">advertising.profitability.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="advertising_site_id"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <filter name="income" string="Income"
                        domain="[('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
                <filter name="costs" string="Costs"
                        domain="[('move_type', 'in', ('in_invoice', 'in_refund'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_site" string="Site" context="{'group_by': 'advertising_site_id'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advertising_profitability_action" model="ir.actions.act_window">
        <field name="name">Site Profitability</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('advertising_site_id', '!=', False), ('parent_state', '=', 'posted'), ('display_type', '=', 'product')]</field>
        <field name="search_view_id" ref="advertising_profitability_view_search"/>
    </record>
</odoo>
