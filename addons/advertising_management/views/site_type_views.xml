<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advertising_site_type_view_list" model="ir.ui.view">
        <field name="name">advertising.site.type.list</field>
        <field name="model">advertising.site.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="site_count"/>
            </list>
        </field>
    </record>

    <record id="advertising_site_type_action" model="ir.actions.act_window">
        <field name="name">Site Types</field>
        <field name="res_model">advertising.site.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
