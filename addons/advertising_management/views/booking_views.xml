<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advertising_booking_view_form" model="ir.ui.view">
        <field name="name">advertising.booking.form</field>
        <field name="model">advertising.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed', 'active')"
                            confirm="Are you sure you want to cancel this booking? The sites will become available again."/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" string="Quotation" invisible="not sale_order_id"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="contract_ref"/>
                            <field name="sale_order_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sites" name="sites">
                            <field name="line_ids" readonly="state in ('completed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="site_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="billing_frequency"/>
                                    <field name="period_count"
                                           readonly="billing_frequency != 'custom'"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show"/>
                                    <field name="price_subtotal"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <separator string="Additional Charges"/>
                            <field name="charge_ids" readonly="state in ('completed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Terms and Conditions" name="terms">
                            <field name="terms"/>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="advertising_booking_view_list" model="ir.ui.view">
        <field name="name">advertising.booking.list</field>
        <field name="model">advertising.booking</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'active'">
                <field name="name"/>
                <field name="contract_ref" optional="show"/>
                <field name="partner_id"/>
                <field name="site_count"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ('draft', 'cancelled')"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advertising_booking_view_search" model="ir.ui.view">
        <field name="name">advertising.booking.search</field>
        <field name="model">advertising.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Booking" filter_domain="['|', ('name', 'ilike', self), ('contract_ref', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="line_ids" string="Site" filter_domain="[('line_ids.site_id', 'ilike', self)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Upcoming" domain="[('state', '=', 'confirmed')]"/>
                <filter name="active" string="Current" domain="[('state', '=', 'active')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advertising_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">advertising.booking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="advertising_booking_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first booking</p>
            <p>Bookings are created from accepted quotations or directly for a customer.</p>
        </field>
    </record>

    <!-- Schedule: one record per booked site period -->
    <record id="advertising_booking_line_view_calendar" model="ir.ui.view">
        <field name="name">advertising.booking.line.calendar</field>
        <field name="model">advertising.booking.line</field>
        <field name="arch" type="xml">
            <calendar string="Site Schedule" date_start="date_start" date_stop="date_end"
                      mode="month" color="site_id" quick_create="0" event_open_popup="1">
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="advertising_booking_line_view_list" model="ir.ui.view">
        <field name="name">advertising.booking.line.list</field>
        <field name="model">advertising.booking.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-muted="state in ('draft', 'cancelled')">
                <field name="site_id"/>
                <field name="site_type_id" optional="show"/>
                <field name="booking_id"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="advertising_booking_line_view_search" model="ir.ui.view">
        <field name="name">advertising.booking.line.search</field>
        <field name="model">advertising.booking.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="booking_id"/>
                <filter name="occupied" string="Occupied / Reserved" domain="[('state', 'in', ('confirmed', 'active'))]"/>
                <filter name="history" string="Completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_site_type" string="Site Type" context="{'group_by': 'site_type_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advertising_schedule_action" model="ir.actions.act_window">
        <field name="name">Site Schedule</field>
        <field name="res_model">advertising.booking.line</field>
        <field name="view_mode">calendar,list</field>
        <field name="search_view_id" ref="advertising_booking_line_view_search"/>
        <field name="context">{'search_default_occupied': 1}</field>
    </record>
</odoo>
