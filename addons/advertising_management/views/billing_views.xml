<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bulk wizard -->
    <record id="advertising_schedule_wizard_view_form" model="ir.ui.view">
        <field name="name">advertising.schedule.wizard.form</field>
        <field name="model">advertising.schedule.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Create the billing periods of the selected records from their dates and billing frequency.
                    Periods that are already invoiced are never changed. Use the date below for historical
                    records so their past periods are not invoiced again.
                </p>
                <group>
                    <field name="skip_before"/>
                    <field name="booking_ids" widget="many2many_tags" invisible="not booking_ids"/>
                    <field name="lease_ids" widget="many2many_tags" invisible="not lease_ids"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="advertising_schedule_wizard_booking_action" model="ir.actions.act_window">
        <field name="name">Generate Billing Schedule</field>
        <field name="res_model">advertising.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_advertising_booking"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="advertising_schedule_wizard_lease_action" model="ir.actions.act_window">
        <field name="name">Generate Payment Schedule</field>
        <field name="res_model">advertising.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_advertising_lease"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Customer billing schedule -->
    <record id="advertising_billing_schedule_view_list" model="ir.ui.view">
        <field name="name">advertising.billing.schedule.list</field>
        <field name="model">advertising.billing.schedule</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'skipped'">
                <header>
                    <button name="action_create_invoices" type="object" string="Create Invoices"/>
                    <button name="action_skip" type="object" string="Do Not Invoice"/>
                    <button name="action_restore" type="object" string="Restore"/>
                </header>
                <field name="booking_id"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="invoice_date"/>
                <field name="quantity" optional="hide"/>
                <field name="amount_untaxed" sum="Total"/>
                <field name="move_id"/>
                <field name="payment_state" widget="badge" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'invoiced'"
                       decoration-warning="state == 'to_invoice'"
                       decoration-muted="state == 'skipped'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advertising_billing_schedule_view_search" model="ir.ui.view">
        <field name="name">advertising.billing.schedule.search</field>
        <field name="model">advertising.billing.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="booking_id"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <filter name="due" string="Due"
                        domain="[('state', '=', 'to_invoice'), ('invoice_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="to_invoice" string="To Invoice" domain="[('state', '=', 'to_invoice')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_booking" string="Booking" context="{'group_by': 'booking_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_month" string="Invoice Month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advertising_billing_schedule_action" model="ir.actions.act_window">
        <field name="name">Billing Schedule</field>
        <field name="res_model">advertising.billing.schedule</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="advertising_billing_schedule_view_search"/>
        <field name="context">{'search_default_to_invoice': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No billing period yet</p>
            <p>Billing periods are created when a booking is confirmed, or with the "Generate Billing Schedule" action.</p>
        </field>
    </record>

    <!-- Booking form: billing -->
    <record id="advertising_booking_view_form_billing" model="ir.ui.view">
        <field name="name">advertising.booking.form.billing</field>
        <field name="model">advertising.booking</field>
        <field name="inherit_id" ref="advertising_booking_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_draft']" position="after">
                <button name="action_create_due_invoices" string="Create Invoices" type="object"
                        invisible="state not in ('confirmed', 'active', 'completed')"
                        groups="account.group_account_invoice"/>
                <button name="%(advertising_schedule_wizard_booking_action)d" string="Generate Billing Schedule"
                        type="action" invisible="state == 'cancelled'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="invoice_count == 0" groups="account.group_account_readonly">
                    <div class="o_stat_info">
                        <field name="invoice_count" class="o_stat_value"/>
                        <span class="o_stat_text">Invoices</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='contract_ref']" position="after">
                <field name="auto_invoice"/>
            </xpath>
            <xpath expr="//page[@name='terms']" position="before">
                <page string="Billing" name="billing">
                    <field name="schedule_ids">
                        <list create="0" delete="0" editable="bottom" decoration-muted="state == 'skipped'">
                            <field name="site_id" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="invoice_date" readonly="state == 'invoiced'"/>
                            <field name="quantity" readonly="state == 'invoiced'" optional="hide"/>
                            <field name="amount_untaxed" sum="Total"/>
                            <field name="skip" readonly="state == 'invoiced'"/>
                            <field name="move_id" readonly="1"/>
                            <field name="payment_state" widget="badge" optional="show"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'invoiced'"
                                   decoration-warning="state == 'to_invoice'"
                                   decoration-muted="state == 'skipped'"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
                <page string="Invoices" name="invoices" groups="account.group_account_readonly">
                    <field name="invoice_ids" readonly="1">
                        <list decoration-danger="advertising_overdue">
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="advertising_amount_paid" sum="Paid"/>
                            <field name="amount_residual" sum="Outstanding"/>
                            <field name="payment_state" widget="badge"/>
                            <field name="advertising_overdue" optional="show"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="amount_invoiced"/>
                        <field name="amount_paid"/>
                        <field name="amount_outstanding" class="oe_subtotal_footer_separator"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
