<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advertising_lease_view_form" model="ir.ui.view">
        <field name="name">advertising.lease.form</field>
        <field name="model">advertising.lease</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_due_bills" string="Create Bills" type="object"
                            invisible="state not in ('active', 'expired')"
                            groups="account.group_account_invoice"/>
                    <button name="%(advertising_schedule_wizard_lease_action)d" string="Generate Payment Schedule"
                            type="action" invisible="state in ('draft', 'cancelled')"/>
                    <button name="action_renew" string="Renew" type="object"
                            invisible="state not in ('active', 'expired')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'active')"
                            confirm="Are you sure you want to cancel this lease?"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bills" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="bill_count == 0" groups="account.group_account_readonly">
                            <div class="o_stat_info">
                                <field name="bill_count" class="o_stat_value"/>
                                <span class="o_stat_text">Vendor Bills</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="site_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="renewal_date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="payment_frequency"/>
                            <field name="other_charges"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="auto_bill"/>
                            <field name="company_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Schedule" name="schedule">
                            <field name="schedule_ids">
                                <list create="0" delete="0" editable="bottom" decoration-muted="state == 'skipped'">
                                    <field name="date_from" readonly="1"/>
                                    <field name="date_to" readonly="1"/>
                                    <field name="invoice_date" readonly="state == 'invoiced'"/>
                                    <field name="quantity" readonly="state == 'invoiced'" optional="hide"/>
                                    <field name="amount_untaxed" sum="Total"/>
                                    <field name="skip" readonly="state == 'invoiced'"/>
                                    <field name="move_id" readonly="1"/>
                                    <field name="payment_state" widget="badge" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'invoiced'"
                                           decoration-warning="state == 'to_invoice'"
                                           decoration-muted="state == 'skipped'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vendor Bills" name="bills" groups="account.group_account_readonly">
                            <field name="bill_ids" readonly="1">
                                <list decoration-danger="advertising_overdue">
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="advertising_amount_paid" sum="Paid"/>
                                    <field name="amount_residual" sum="Outstanding"/>
                                    <field name="payment_state" widget="badge"/>
                                    <field name="advertising_overdue" optional="show"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_billed"/>
                                <field name="amount_paid"/>
                                <field name="amount_outstanding" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Terms and Conditions" name="terms">
                            <field name="terms"/>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="advertising_lease_view_list" model="ir.ui.view">
        <field name="name">advertising.lease.list</field>
        <field name="model">advertising.lease</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'expired')">
                <field name="name"/>
                <field name="site_id"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="renewal_date" optional="show"/>
                <field name="amount"/>
                <field name="payment_frequency" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ('draft', 'cancelled', 'expired')"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advertising_lease_view_search" model="ir.ui.view">
        <field name="name">advertising.lease.search</field>
        <field name="model">advertising.lease</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="site_id"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="renewal_due" string="Renewal Due"
                        domain="[('state', '=', 'active'), ('renewal_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Landlord" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advertising_lease_action" model="ir.actions.act_window">
        <field name="name">Landlord Leases</field>
        <field name="res_model">advertising.lease</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="advertising_lease_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first landlord lease</p>
            <p>Track what you pay landlords for leased sites. Vendor bills are generated from the payment schedule.</p>
        </field>
    </record>

    <!-- Lease payment schedule -->
    <record id="advertising_lease_schedule_view_list" model="ir.ui.view">
        <field name="name">advertising.lease.schedule.list</field>
        <field name="model">advertising.lease.schedule</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'skipped'">
                <header>
                    <button name="action_create_invoices" type="object" string="Create Bills"/>
                    <button name="action_skip" type="object" string="Do Not Bill"/>
                    <button name="action_restore" type="object" string="Restore"/>
                </header>
                <field name="lease_id"/>
                <field name="partner_id"/>
                <field name="site_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="invoice_date" string="Bill Date"/>
                <field name="quantity" optional="hide"/>
                <field name="amount_untaxed" sum="Total"/>
                <field name="move_id" string="Vendor Bill"/>
                <field name="payment_state" widget="badge" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'invoiced'"
                       decoration-warning="state == 'to_invoice'"
                       decoration-muted="state == 'skipped'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advertising_lease_schedule_view_search" model="ir.ui.view">
        <field name="name">advertising.lease.schedule.search</field>
        <field name="model">advertising.lease.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="lease_id"/>
                <field name="partner_id" string="Landlord"/>
                <field name="site_id"/>
                <filter name="due" string="Due"
                        domain="[('state', '=', 'to_invoice'), ('invoice_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="to_invoice" string="To Bill" domain="[('state', '=', 'to_invoice')]"/>
                <filter name="invoiced" string="Billed" domain="[('state', '=', 'invoiced')]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_lease" string="Lease" context="{'group_by': 'lease_id'}"/>
                    <filter name="group_partner" string="Landlord" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_site" string="Site" context="{'group_by': 'site_id'}"/>
                    <filter name="group_month" string="Bill Month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advertising_lease_schedule_action" model="ir.actions.act_window">
        <field name="name">Payment Schedule</field>
        <field name="res_model">advertising.lease.schedule</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="advertising_lease_schedule_view_search"/>
        <field name="context">{'search_default_to_invoice': 1}</field>
    </record>

    <!-- Site form: leases and financials -->
    <record id="advertising_site_view_form_finance" model="ir.ui.view">
        <field name="name">advertising.site.form.finance</field>
        <field name="model">advertising.site</field>
        <field name="inherit_id" ref="advertising_site_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_leases" type="object" class="oe_stat_button" icon="fa-handshake-o"
                        invisible="ownership != 'leased'" groups="account.group_account_readonly">
                    <field name="lease_count" widget="statinfo" string="Leases"/>
                </button>
                <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                        invisible="invoice_count == 0"
                        groups="advertising_management.group_advertising_accounting">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
                <button name="action_view_bills" type="object" class="oe_stat_button" icon="fa-money"
                        invisible="bill_count == 0"
                        groups="advertising_management.group_advertising_accounting">
                    <field name="bill_count" widget="statinfo" string="Vendor Bills"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='notes']" position="before">
                <page string="Leases" name="leases" invisible="ownership != 'leased'"
                      groups="account.group_account_readonly">
                    <field name="lease_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="amount"/>
                            <field name="payment_frequency"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
                <page string="Financials" name="financials"
                      groups="advertising_management.group_advertising_accounting">
                    <group>
                        <group string="Posted invoices and vendor bills">
                            <field name="revenue"/>
                            <field name="cost"/>
                            <field name="profit" class="fw-bold"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="advertising_site_view_list_finance" model="ir.ui.view">
        <field name="name">advertising.site.list.finance</field>
        <field name="model">advertising.site</field>
        <field name="inherit_id" ref="advertising_site_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_billing_frequency']" position="after">
                <field name="revenue" optional="hide" groups="advertising_management.group_advertising_accounting"/>
                <field name="cost" optional="hide" groups="advertising_management.group_advertising_accounting"/>
                <field name="profit" optional="hide" groups="advertising_management.group_advertising_accounting"/>
            </xpath>
        </field>
    </record>
</odoo>
