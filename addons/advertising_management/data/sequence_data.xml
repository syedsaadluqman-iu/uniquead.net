<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_advertising_site" model="ir.sequence">
            <field name="name">Advertising Site</field>
            <field name="code">advertising.site</field>
            <field name="prefix">SITE-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_advertising_booking" model="ir.sequence">
            <field name="name">Advertising Booking</field>
            <field name="code">advertising.booking</field>
            <field name="prefix">BK/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
