            <field name="code">model._cron_generate_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="cron_advertising_update_leases" model="ir.cron">
            <field name="name">Advertising: update leases and generate vendor bills</field>
            <field name="model_id" ref="model_advertising_lease"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_leases()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
