<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_advertising_update_states" model="ir.cron">
            <field name="name">Advertising: update booking and site statuses</field>
            <field name="model_id" ref="model_advertising_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_states()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="cron_advertising_generate_invoices" model="ir.cron">
            <field name="name">Advertising: generate customer invoices</field>
            <field name="model_id" ref="model_advertising_billing_schedule"/>
